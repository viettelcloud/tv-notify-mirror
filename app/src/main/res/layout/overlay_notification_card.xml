<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="380dp"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/overlay_card_bg"
    android:elevation="16dp"
    android:orientation="vertical">

    <!-- Header: App Icon, App Name, Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/overlay_app_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="App Icon"
            android:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/overlay_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Zalo"
            android:textAllCaps="true"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/overlay_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:45 AM"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Title / Sender Name -->
    <TextView
        android:id="@+id/overlay_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="John Doe"
        android:textColor="#F8FAFC"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Message Snippet -->
    <TextView
        android:id="@+id/overlay_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Hello, see you on TV!"
        android:textColor="#CBD5E1"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp" />

    <!-- 5-Second Auto Dismiss Countdown Bar -->
    <ProgressBar
        android:id="@+id/overlay_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="100"
        android:progressTint="#38BDF8" />

</LinearLayout>
